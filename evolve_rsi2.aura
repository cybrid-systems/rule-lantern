; RSI2 closed loop. One Soft process, AURA_SANDBOX=off.
; set-code of lantern.aura (Arena T), then a behavior-matched factoring
; that names four kernel knobs. step is not rewritten: it still calls
; dodge-chip, binds base-taken, and adds chip. Knobs rebind by
; hot-strategy:swap! on the helpers:
;   chip-turn-floor, clean-win-hp-floor, finish-bonus, late-strike-floor
; Rule strike-turn genes and opp-policy alternate for 4 rounds.
; After every swap the workspace source must still contain dodge-chip,
; base-taken, and (taken (+ base-taken chip)). A miss heals and stamps
; RSI2_GATE_REJECT. This file does not edit the host tree.

(require "std/swarm" all:)
(require "std/hot-strategy" all:)

(define *rule0*
  "(lambda (hp ehp turn) (cond ((or (= turn 2) (= turn 4) (= turn 5) (= turn 20)) 1) (#t 2)))")
(define *opp0*
  "(lambda (turn) (if (or (= (modulo turn 2) 1) (>= turn 5)) (if (>= turn 6) 3 2) 0))")
(define *opp-factor*
  "(lambda (turn) (if (or (= (modulo turn 2) 1) (>= turn (late-strike-floor))) (if (>= turn 6) 3 2) 0))")

(define *rule-body* *rule0*)
(define *rule-turns* (list 2 4 5 20))
(define *opp-body* *opp-factor*)
(define *knob-chip* 15)
(define *knob-hp* 2)
(define *knob-bonus* 2)
(define *knob-late* 5)
(define *knob-best-current* -1)
(define *rule-best-current* -1)
(define *vsb* -1)
(define *vsb-rule* *rule0*)
(define *vsb-turns* (list 2 4 5 20))
(define *vsb-opp* *opp-factor*)
(define *vsb-chip* 15)
(define *vsb-hp* 2)
(define *vsb-bonus* 2)
(define *vsb-late* 5)
(define *opp-player* 1000000)
(define *heals* 0)
(define *heal-fail* 0)
(define *swaps* 0)
(define *swap-ok* 0)
(define *gate-rejects* 0)
(define *rounds-done* 0)
(define *fiber* 0)
(define *fiber-note* "not-run")
(define *base* -1)
(define *factor-play* -1)

(define (show k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(define (nth xs i)
  (let loop ((ys xs) (k i))
    (if (null? ys) 0
        (if (= k 0) (car ys) (loop (cdr ys) (- k 1))))))

(define (clamp-int x lo hi)
  (let ((n (round x)))
    (cond ((< n lo) lo)
          ((> n hi) hi)
          (#t n))))

(define (clamp n lo hi)
  (cond ((< n lo) lo)
        ((> n hi) hi)
        (#t n)))

(define (fresh n a b c)
  (let loop ((k n) (guard 0))
    (cond ((> guard 60) n)
          ((or (= k a) (= k b) (= k c))
           (loop (if (>= k 40) 2 (+ k 1)) (+ guard 1)))
          (#t k))))

(define (knob-body n)
  (string-append "(lambda () " (number->string n) ")"))

(define (genes->turns ind)
  (let* ((a (clamp-int (nth ind 0) 2 40))
         (b (fresh (clamp-int (nth ind 1) 2 40) a -1 -1))
         (c (fresh (clamp-int (nth ind 2) 2 40) a b -1))
         (d (fresh (clamp-int (nth ind 3) 2 40) a b c)))
    (list a b c d)))

(define (turns->body ts)
  (string-append
    "(lambda (hp ehp turn) (cond ((or (= turn " (number->string (nth ts 0))
    ") (= turn " (number->string (nth ts 1))
    ") (= turn " (number->string (nth ts 2))
    ") (= turn " (number->string (nth ts 3))
    ")) 1) (#t 2)))"))

(define (ant-rule-turns name)
  (cond ((equal? name "t-24520") (list 2 4 5 20))
        ((equal? name "t-24516") (list 2 4 5 16))
        ((equal? name "t-24518") (list 2 4 5 18))
        ((equal? name "t-24519") (list 2 4 5 19))
        ((equal? name "t-23416") (list 2 3 4 16))
        ((equal? name "t-24512") (list 2 4 5 12))
        ((equal? name "t-1234") (list 1 2 3 4))
        (#t (list 2 4 5 20))))

(define (rule-of ind)
  (if (string? ind)
      (let ((ts (ant-rule-turns ind)))
        (cons (turns->body ts) ts))
      (let ((ts (genes->turns ind)))
        (cons (turns->body ts) ts))))

(define (opp-genes->body ind)
  (let* ((start (clamp-int (nth ind 0) 1 30))
         (brk (clamp-int (nth ind 1) 1 40))
         (early (if (< (nth ind 2) 21.0) 2 3))
         (late (if (< (nth ind 3) 21.0) 2 3)))
    (string-append
      "(lambda (turn) (if (>= turn " (number->string start)
      ") (if (>= turn " (number->string brk)
      ") " (number->string late)
      " " (number->string early)
      ") (if (= (modulo turn 2) 1) " (number->string early)
      " 0)))")))

(define (ant-opp-body name)
  (cond ((equal? name "o-b") *opp0*)
        ((equal? name "o-factor") *opp-factor*)
        ((equal? name "o-all3") (opp-genes->body (list 1 1 30 30)))
        ((equal? name "o-all2") (opp-genes->body (list 1 1 0 0)))
        ((equal? name "o-from5") (opp-genes->body (list 5 6 0 30)))
        ((equal? name "o-from1-d2") (opp-genes->body (list 1 48 0 0)))
        ((equal? name "o-late") (opp-genes->body (list 2 34 0 0)))
        (#t *opp0*)))

(define (opp-of ind)
  (if (string? ind) (ant-opp-body ind) (opp-genes->body ind)))

(define (ant-knobs name)
  (cond ((equal? name "k-base") (list 15 2 2))
        ((equal? name "k-c12") (list 12 2 2))
        ((equal? name "k-c16") (list 16 2 2))
        ((equal? name "k-c18") (list 18 2 2))
        ((equal? name "k-c20") (list 20 2 2))
        ((equal? name "k-c24") (list 24 2 2))
        ((equal? name "k-c30") (list 30 2 2))
        ((equal? name "k-c48") (list 48 2 2))
        ((equal? name "k-hp0") (list 15 0 2))
        ((equal? name "k-hp1") (list 15 1 2))
        ((equal? name "k-b0") (list 15 2 0))
        ((equal? name "k-b4") (list 15 2 4))
        ((equal? name "k-c20-hp0") (list 20 0 2))
        ((equal? name "k-c20-hp1") (list 20 1 2))
        ((equal? name "k-c18-b2") (list 18 2 2))
        (#t (list 15 2 2))))

(define (knob-of ind)
  (if (string? ind)
      (ant-knobs ind)
      (list (clamp-int (nth ind 0) 1 48)
            (clamp-int (nth ind 1) 0 8)
            (clamp-int (nth ind 2) 0 4))))

(define (ant-late name)
  (cond ((equal? name "l-1") 1)
        ((equal? name "l-3") 3)
        ((equal? name "l-5") 5)
        ((equal? name "l-8") 8)
        ((equal? name "l-12") 12)
        ((equal? name "l-20") 20)
        ((equal? name "l-30") 30)
        (#t 5)))

(define (late-of ind)
  (if (string? ind)
      (ant-late ind)
      (clamp-int (nth ind 0) 1 40)))

(define (has? s needle)
  (and (string? s) (string-contains? s needle)))

(define (step-legit?)
  (let ((s (try (current-source :workspace) (catch (e) ""))))
    (and (has? s "dodge-chip")
         (has? s "base-taken")
         (has? s "(taken (+ base-taken chip))")
         (not (has? s "(taken (/ base-taken chip))")))))

(define (vs-b?)
  (or (equal? *opp-body* *opp0*)
      (and (equal? *opp-body* *opp-factor*)
           (= *knob-late* 5))))

(define (arm! name body)
  (hot-strategy:register! name body))

(define (heal-active!)
  (let ((h (try (hot-strategy:heal!) (catch (e) #f))))
    (if h
        #t
        (begin
          (set! *heal-fail* (+ *heal-fail* 1))
          #f))))

(define (note-vs-b! score)
  (if (and (number? score) (step-legit?) (vs-b?) (> score *vsb*))
      (begin
        (set! *vsb* score)
        (set! *vsb-rule* *rule-body*)
        (set! *vsb-turns* *rule-turns*)
        (set! *vsb-opp* *opp-body*)
        (set! *vsb-chip* *knob-chip*)
        (set! *vsb-hp* *knob-hp*)
        (set! *vsb-bonus* *knob-bonus*)
        (set! *vsb-late* *knob-late*)
        score)
      #f))

(define *factor-src* "(export play rule opp-policy opp-strike? opp-damage chip-turn-floor clean-win-hp-floor finish-bonus late-strike-floor dodge-chip)
(define (chip-turn-floor) 15)
(define (clean-win-hp-floor) 2)
(define (finish-bonus) 2)
(define (late-strike-floor) 5)
(define (rule hp ehp turn)
  (cond ((or (= turn 2) (= turn 4) (= turn 5) (= turn 20)) 1)
        (#t 2)))
(define (opp-policy turn)
  (if (or (= (modulo turn 2) 1) (>= turn (late-strike-floor)))
      (if (>= turn 6) 3 2)
      0))
(define (opp-strike? turn)
  (> (opp-policy turn) 0))
(define (opp-damage turn)
  (let ((p (opp-policy turn)))
    (if (> p 0) p 2)))
(define (dodge-chip turn action them)
  (if (and (>= turn (chip-turn-floor)) them (= action 2)) 1 0))
(define (clamp n lo hi)
  (cond ((< n lo) lo)
        ((> n hi) hi)
        (#t n)))
(define (step hp ehp turn action)
  (let* ((them (opp-strike? turn))
         (dealt (if (= action 1) 2 0))
         (chip (dodge-chip turn action them))
         (base-taken (cond ((and them (= action 2)) 0)
                           (them (opp-damage turn))
                           (#t 0)))
         (taken (+ base-taken chip))
         (healed (if (= action 0) 1 0))
         (hp2 (clamp (- (+ hp healed) taken) 0 8))
         (ehp2 (clamp (- ehp dealt) 0 8)))
    (cons hp2 ehp2)))
(define (play)
  (let loop ((hp 8) (ehp 8) (turn 1) (score 0))
    (cond ((or (<= hp 0) (<= ehp 0) (> turn 48)) score)
          (#t
           (let* ((action (rule hp ehp turn))
                  (dealt (if (= action 1) 2 0))
                  (nxt (step hp ehp turn action))
                  (hp2 (car nxt))
                  (ehp2 (cdr nxt))
                  (lived (if (> hp2 0) 1 0))
                  (bonus (if (and (<= ehp2 0) (>= hp2 (clean-win-hp-floor))) (finish-bonus) 0)))
             (loop hp2 ehp2 (+ turn 1) (+ score dealt lived bonus)))))))
")

(define (install-raw)
  (let ((src (try (read-file "/workspace/rule-lantern/lantern.aura")
                  (catch (e) e))))
    (if (not (string? src))
        #f
        (let ((sc (try (set-code src) (catch (e) e))))
          (show "SET_CODE" (if (equal? sc #t) "ok" sc))
          (if (equal? sc #t)
              (begin (eval-current) #t)
              #f)))))

(define (install-factored)
  (let ((sc (try (set-code *factor-src*) (catch (e) e))))
    (show "SET_CODE_FACTOR" (if (equal? sc #t) "ok" sc))
    (if (equal? sc #t)
        (begin (eval-current) #t)
        #f)))

(define (restore-snap s)
  (let ((r (try (ast:restore s) (catch (e) #f))))
    (try (eval-current) (catch (e) #f))
    (set! *heals* (+ *heals* 1))
    (if (step-legit?)
        r
        (begin
          (set! *heal-fail* (+ *heal-fail* 1))
          #f))))

(define (gate-reject! name)
  (set! *gate-rejects* (+ *gate-rejects* 1))
  (show "RSI2_GATE_REJECT" name)
  (set! *heals* (+ *heals* 1))
  (heal-active!)
  (if (step-legit?)
      #f
      (begin
        (install-factored)
        #f)))

(define (swap-ok? name body)
  (set! *swaps* (+ *swaps* 1))
  (let ((r (try (hot-strategy:swap! name body "rsi2")
                (catch (e) (list #f e)))))
    (if (not (and (pair? r) (equal? (car r) #t)))
        #f
        (if (step-legit?)
            (begin
              (set! *swap-ok* (+ *swap-ok* 1))
              #t)
            (gate-reject! name)))))

(define (apply-kept!)
  (swap-ok? "rule" *rule-body*)
  (swap-ok? "opp-policy" *opp-body*)
  (swap-ok? "chip-turn-floor" (knob-body *knob-chip*))
  (swap-ok? "clean-win-hp-floor" (knob-body *knob-hp*))
  (swap-ok? "finish-bonus" (knob-body *knob-bonus*))
  (swap-ok? "late-strike-floor" (knob-body *knob-late*))
  (arm! "rule" *rule-body*))

(define (rule-fit ind)
  (let* ((rb (rule-of ind))
         (body (car rb))
         (ts (cdr rb)))
    (if (not (swap-ok? "rule" body))
        -1000000.0
        (let ((score (try (play) (catch (e) -1))))
          (cond ((not (number? score))
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 -1000000.0)
                ((and (step-legit?) (> score *rule-best-current*))
                 (set! *rule-best-current* score)
                 (set! *rule-body* body)
                 (set! *rule-turns* ts)
                 (note-vs-b! score)
                 (arm! "rule" body)
                 score)
                ((< score *rule-best-current*)
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 score)
                (#t score))))))

(define (knob-fit ind)
  (let* ((ks (knob-of ind))
         (chip (nth ks 0))
         (hp (nth ks 1))
         (bonus (nth ks 2))
         (snap (hot-strategy:snapshot! "knob")))
    (if (not (and (swap-ok? "chip-turn-floor" (knob-body chip))
                  (swap-ok? "clean-win-hp-floor" (knob-body hp))
                  (swap-ok? "finish-bonus" (knob-body bonus))
                  (step-legit?)))
        (begin
          (restore-snap snap)
          -1000000.0)
        (let ((score (try (play) (catch (e) -1))))
          (cond ((not (number? score))
                 (restore-snap snap)
                 -1000000.0)
                ((> score *knob-best-current*)
                 (set! *knob-best-current* score)
                 (set! *knob-chip* chip)
                 (set! *knob-hp* hp)
                 (set! *knob-bonus* bonus)
                 (note-vs-b! score)
                 (arm! "finish-bonus" (knob-body bonus))
                 score)
                (#t
                 (restore-snap snap)
                 score))))))

(define (opp-fit ind)
  (let ((body (opp-of ind)))
    (if (not (swap-ok? "opp-policy" body))
        -1000000.0
        (let ((score (try (play) (catch (e) 1000000))))
          (cond ((not (number? score))
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 -1000000.0)
                ((and (step-legit?) (< score *opp-player*))
                 (set! *opp-player* score)
                 (set! *opp-body* body)
                 (arm! "opp-policy" body)
                 (- 0.0 score))
                ((> score *opp-player*)
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 (- 0.0 score))
                (#t (- 0.0 score)))))))

(define (late-fit ind)
  (let ((n (late-of ind))
        (snap (hot-strategy:snapshot! "late")))
    (if (not (swap-ok? "late-strike-floor" (knob-body n)))
        (begin
          (restore-snap snap)
          -1000000.0)
        (let ((score (try (play) (catch (e) 1000000))))
          (cond ((not (number? score))
                 (restore-snap snap)
                 -1000000.0)
                ((and (step-legit?) (< score *opp-player*))
                 (set! *opp-player* score)
                 (set! *knob-late* n)
                 (arm! "late-strike-floor" (knob-body n))
                 (- 0.0 score))
                (#t
                 (restore-snap snap)
                 (- 0.0 score)))))))

(define (bounds4 lo hi)
  (list (list lo hi) (list lo hi) (list lo hi) (list lo hi)))

(define (init-pso seed pop lo hi)
  (swarm:parallel! #f)
  (swarm:init (hash "kind" "pso" "dim" 4 "pop" pop "seed" seed
                    "bounds" (bounds4 lo hi))))

(define (init-knob-pso seed)
  (swarm:parallel! #f)
  (swarm:init (hash "kind" "pso" "dim" 3 "pop" 6 "seed" seed
                    "bounds" (list (list 1.0 48.0)
                                   (list 0.0 8.0)
                                   (list 0.0 4.0)))))

(define (init-late-pso seed)
  (swarm:parallel! #f)
  (swarm:init (hash "kind" "pso" "dim" 1 "pop" 4 "seed" seed
                    "bounds" (list (list 1.0 40.0)))))

(define (init-ant seed ops pop)
  (swarm:parallel! #f)
  (swarm:init (hash "kind" "ant" "pop" pop "seed" seed "evaporate" 0.9
                    "ops" ops)))

(define *rule-ops*
  (list "t-24520" "t-24516" "t-24518" "t-24519" "t-23416" "t-24512" "t-1234"))
(define *opp-ops*
  (list "o-b" "o-factor" "o-all3" "o-all2" "o-from5" "o-from1-d2" "o-late"))
(define *knob-ops*
  (list "k-base" "k-c12" "k-c16" "k-c18" "k-c20" "k-c24" "k-c30" "k-c48"
        "k-hp0" "k-hp1" "k-b0" "k-b4" "k-c20-hp0" "k-c20-hp1" "k-c18-b2"))
(define *late-ops*
  (list "l-1" "l-3" "l-5" "l-8" "l-12" "l-20" "l-30"))

(define (rule-step kind)
  (arm! "rule" *rule-body*)
  (try (swarm:step! rule-fit) (catch (e) (show "RULE_STEP_ERR" e)))
  (show "RSI2_KIND" (string-append "rule:" kind ":" (swarm:kind)))
  (swap-ok? "rule" *rule-body*)
  (arm! "rule" *rule-body*))

(define (knob-step kind)
  (arm! "chip-turn-floor" (knob-body *knob-chip*))
  (try (swarm:step! knob-fit) (catch (e) (show "KNOB_STEP_ERR" e)))
  (show "RSI2_KIND" (string-append "knob:" kind ":" (swarm:kind)))
  (swap-ok? "chip-turn-floor" (knob-body *knob-chip*))
  (swap-ok? "clean-win-hp-floor" (knob-body *knob-hp*))
  (swap-ok? "finish-bonus" (knob-body *knob-bonus*))
  (arm! "finish-bonus" (knob-body *knob-bonus*)))

(define (opp-step kind)
  (arm! "opp-policy" *opp-body*)
  (try (swarm:step! opp-fit) (catch (e) (show "OPP_STEP_ERR" e)))
  (show "RSI2_KIND" (string-append "opp:" kind ":" (swarm:kind)))
  (swap-ok? "opp-policy" *opp-body*)
  (arm! "opp-policy" *opp-body*))

(define (late-step kind)
  (arm! "late-strike-floor" (knob-body *knob-late*))
  (try (swarm:step! late-fit) (catch (e) (show "LATE_STEP_ERR" e)))
  (show "RSI2_KIND" (string-append "late:" kind ":" (swarm:kind)))
  (swap-ok? "late-strike-floor" (knob-body *knob-late*))
  (arm! "late-strike-floor" (knob-body *knob-late*)))

(define (knob-stamp)
  (string-append
    "chip=" (number->string *vsb-chip*)
    ",hp=" (number->string *vsb-hp*)
    ",bonus=" (number->string *vsb-bonus*)
    ",late=" (number->string *vsb-late*)))

(define (emit-round n in-r rs ks)
  (let ((os (try (play) (catch (e) -1))))
    (set! *rounds-done* n)
    (display "ROUND ")
    (display n)
    (display " IN=")
    (display in-r)
    (display " RULE=")
    (display rs)
    (display " KNOB=")
    (display ks)
    (display " OPP=")
    (display os)
    (display " TURNS=")
    (display *rule-turns*)
    (display " KNOBS=")
    (display (list *knob-chip* *knob-hp* *knob-bonus* *knob-late*))
    (newline)))

(define (one-round n)
  (let ((in-r (try (play) (catch (e) -1))))
    (set! *rule-best-current* (if (number? in-r) in-r -1))
    (if (= (modulo n 2) 1)
        (begin
          (init-pso (+ 910000 n) 4 2.0 40.0)
          (rule-step "pso"))
        (begin
          (init-ant (+ 920000 n) *rule-ops* 7)
          (rule-step "ant")))
    (let ((rs (try (play) (catch (e) -1))))
      (set! *knob-best-current* (if (number? rs) rs -1))
      (if (= (modulo n 2) 1)
          (begin
            (init-ant (+ 930000 n) *knob-ops* 15)
            (knob-step "ant"))
          (begin
            (init-knob-pso (+ 940000 n))
            (knob-step "pso")))
      (let ((ks (try (play) (catch (e) -1))))
        (set! *opp-player* (if (number? ks) ks 1000000))
        (if (= (modulo n 2) 1)
            (begin
              (init-ant (+ 950000 n) *opp-ops* 7)
              (opp-step "ant"))
            (begin
              (init-pso (+ 960000 n) 4 1.0 40.0)
              (opp-step "pso")))
        (set! *opp-player* (let ((p (try (play) (catch (e) 1000000)))
                             (if (number? p) p 1000000)))
        (if (= (modulo n 2) 1)
            (begin
              (init-ant (+ 970000 n) *late-ops* 7)
              (late-step "ant"))
            (begin
              (init-late-pso (+ 980000 n))
              (late-step "pso")))
        (emit-round n in-r rs ks)))))

; Pure sim for fiber pop. Reads opp-policy. Does not rebind.
; Chip floor, clean-win hp, and finish-bonus are arguments.
(define (sim-at ts chip hp-floor bonus-pts)
  (let loop ((hp 8) (ehp 8) (turn 1) (score 0))
    (cond ((or (<= hp 0) (<= ehp 0) (> turn 48)) score)
          (#t
           (let* ((action (if (or (= turn (nth ts 0))
                                  (= turn (nth ts 1))
                                  (= turn (nth ts 2))
                                  (= turn (nth ts 3)))
                              1 2))
                  (dealt (if (= action 1) 2 0))
                  (pol (opp-policy turn))
                  (them (> pol 0))
                  (chipd (if (and (>= turn chip) them (= action 2)) 1 0))
                  (dmg (if (> pol 0) pol 2))
                  (base-taken (cond ((and them (= action 2)) 0)
                                    (them dmg)
                                    (#t 0)))
                  (taken (+ base-taken chipd))
                  (hp2 (clamp (- hp taken) 0 8))
                  (ehp2 (clamp (- ehp dealt) 0 8))
                  (lived (if (> hp2 0) 1 0))
                  (bonus (if (and (<= ehp2 0) (>= hp2 hp-floor)) bonus-pts 0)))
             (loop hp2 ehp2 (+ turn 1) (+ score dealt lived bonus)))))))

(define (fiber-pop!)
  (let ((spawned (try (fiber:join (fiber:spawn (lambda () 41)))
                      (catch (e) e))))
    (show "FIBER_SPAWN" spawned)
    (if (not (equal? spawned 41))
        (begin
          (set! *fiber* 0)
          (set! *fiber-note* "spawn-join-failed"))
        (let ((base-sim (try (sim-at (list 2 4 5 20) 15 2 2) (catch (e) e)))
              (base-play (try (play) (catch (e) e))))
          (show "FIBER_SIM_BASE" base-sim)
          (show "FIBER_PLAY_BASE" base-play)
          (if (not (equal? base-sim base-play))
              (begin
                (set! *fiber* 0)
                (set! *fiber-note* "sim-mismatch-skip-pop"))
              (let ((pop (try
                           (begin
                             (swarm:init (hash "kind" "pso"
                                               "dim" 3
                                               "pop" 4
                                               "seed" 910099
                                               "parallel" #t
                                               "bounds" (list (list 1.0 48.0)
                                                              (list 0.0 8.0)
                                                              (list 0.0 4.0))))
                             (swarm:step! (lambda (ind)
                                            (sim-at *rule-turns*
                                                    (clamp-int (nth ind 0) 1 48)
                                                    (clamp-int (nth ind 1) 0 8)
                                                    (clamp-int (nth ind 2) 0 4))))
                             (swarm:best))
                           (catch (e) (list "fail" e)))))
                (show "FIBER_POP_BEST" pop)
                (swarm:parallel! #f)
                (if (not (pair? pop))
                    (begin
                      (set! *fiber* 0)
                      (set! *fiber-note* "parallel-step-failed"))
                    (begin
                      (set! *fiber* 1)
                      (set! *fiber-note* "swarm-parallel-pso-knobs")
                      (let* ((chip (clamp-int (nth pop 0) 1 48))
                             (hp (clamp-int (nth pop 1) 0 8))
                             (bonus (clamp-int (nth pop 2) 0 4))
                             (simv (sim-at *rule-turns* chip hp bonus))
                             (snap (hot-strategy:snapshot! "fiber")))
                        (if (and (swap-ok? "chip-turn-floor" (knob-body chip))
                                 (swap-ok? "clean-win-hp-floor" (knob-body hp))
                                 (swap-ok? "finish-bonus" (knob-body bonus)))
                            (let ((sc (try (play) (catch (e) -1))))
                              (show "FIBER_CONFIRM_PLAY" sc)
                              (show "FIBER_CONFIRM_SIM" simv)
                              (if (and (number? sc)
                                       (step-legit?)
                                       (equal? sc simv)
                                       (> sc *vsb*)
                                       (vs-b?))
                                  (begin
                                    (set! *knob-chip* chip)
                                    (set! *knob-hp* hp)
                                    (set! *knob-bonus* bonus)
                                    (set! *knob-best-current* sc)
                                    (note-vs-b! sc)
                                    (arm! "finish-bonus" (knob-body bonus)))
                                  (begin
                                    (restore-snap snap)
                                    (swap-ok? "chip-turn-floor" (knob-body *knob-chip*))
                                    (swap-ok? "clean-win-hp-floor" (knob-body *knob-hp*))
                                    (swap-ok? "finish-bonus" (knob-body *knob-bonus*)))))
                            (begin
                              (show "FIBER_CONFIRM_SWAP_FAIL" 1)
                              (restore-snap snap))))))))))))

(define (probe-gate!)
  (let ((broken "(lambda (hp ehp turn action) (cons hp ehp))"))
    (arm! "rule" *rule-body*)
    (set! *swaps* (+ *swaps* 1))
    (let ((r (try (hot-strategy:swap! "step" broken "rsi2-probe")
                  (catch (e) (list #f e)))))
      (if (not (and (pair? r) (equal? (car r) #t)))
          (show "RSI2_GATE_PROBE" "swap-not-installed")
          (if (step-legit?)
              (begin
                (show "RSI2_GATE_PROBE" "needles-held")
                (set! *heals* (+ *heals* 1))
                (heal-active!))
              (begin
                (show "RSI2_GATE_PROBE" "broken-step")
                (gate-reject! "step"))))
      (arm! "rule" *rule-body*)
      (arm! "opp-policy" *opp-body*)
      (if (not (step-legit?))
          (install-factored)
          #f)
      (show "RSI2_GATE_PROBE_PLAY" (try (play) (catch (e) e))))))

(define (remeasure-vs-b)
  (if (not (install-factored))
      "install-failed"
      (begin
        (if (not (swap-ok? "rule" *vsb-rule*))
            (show "RSI2_REMEASURE_RULE" "fail")
            #f)
        (if (not (swap-ok? "opp-policy" *vsb-opp*))
            (show "RSI2_REMEASURE_OPP" "fail")
            #f)
        (swap-ok? "chip-turn-floor" (knob-body *vsb-chip*))
        (swap-ok? "clean-win-hp-floor" (knob-body *vsb-hp*))
        (swap-ok? "finish-bonus" (knob-body *vsb-bonus*))
        (swap-ok? "late-strike-floor" (knob-body *vsb-late*))
        (if (step-legit?)
            (try (play) (catch (e) e))
            "gate-fail"))))

(define (fail-closed why)
  (show "RSI2_BEST" *vsb*)
  (show "RSI2_VS_B" why)
  (show "RSI2_ROUNDS" *rounds-done*)
  (show "RSI2_HEAL" *heals*)
  (show "RSI2_GATE_REJECTS" *gate-rejects*)
  (show "RSI2_KNOBS" "factor-mismatch")
  (display "RSI2_DONE\n"))

(display "RSI2_START\n")
(if (not (install-raw))
    (fail-closed "install-failed")
    (let ((base (try (play) (catch (e) e))))
      (show "BASE_ARENA_T" base)
      (set! *base* (if (number? base) base -1))
      (if (not (install-factored))
          (fail-closed "factor-install-failed")
          (let ((fp (try (play) (catch (e) e))))
            (show "BASE_FACTOR" fp)
            (set! *factor-play* (if (number? fp) fp -1))
            (if (not (and (number? base) (equal? base fp) (step-legit?)))
                (fail-closed "factor-mismatch")
                (begin
                  (set! *vsb* base)
                  (set! *rule-best-current* base)
                  (set! *knob-best-current* base)
                  (show "RSI2_GATE_AT_INSTALL" (if (step-legit?) 1 0))
                  (arm! "rule" *rule-body*)
                  (arm! "opp-policy" *opp-body*)
                  (arm! "chip-turn-floor" (knob-body 15))
                  (probe-gate!)
                  (if (not (and (step-legit?)
                                (equal? (try (play) (catch (e) e)) *base*)))
                      (begin
                        (install-factored)
                        (show "RSI2_PROBE_RESTORED_PLAY" (try (play) (catch (e) e))))
                      #f)
                  (fiber-pop!)
                  (swarm:parallel! #f)
                  (one-round 1)
                  (one-round 2)
                  (one-round 3)
                  (one-round 4)
                  (let ((vs (remeasure-vs-b)))
                    (show "RSI2_VS_B" vs)
                    (show "RSI2_BEST" *vsb*)
                    (show "RSI2_BEST_TURNS" *vsb-turns*)
                    (show "RSI2_BEST_RULE" *vsb-rule*)
                    (show "RSI2_BEST_OPP" *vsb-opp*)
                    (show "RSI2_KNOBS" (knob-stamp))
                    (show "RSI2_KNOB_LIVE_CHIP" (try (chip-turn-floor) (catch (e) e)))
                    (show "RSI2_KNOB_LIVE_HP" (try (clean-win-hp-floor) (catch (e) e)))
                    (show "RSI2_KNOB_LIVE_BONUS" (try (finish-bonus) (catch (e) e)))
                    (show "RSI2_KNOB_LIVE_LATE" (try (late-strike-floor) (catch (e) e)))
                    (swap-ok? "chip-turn-floor" (knob-body 15))
                    (swap-ok? "clean-win-hp-floor" (knob-body 2))
                    (swap-ok? "finish-bonus" (knob-body 2))
                    (swap-ok? "late-strike-floor" (knob-body 5))
                    (if (not (equal? *vsb-opp* *opp0*))
                        (swap-ok? "opp-policy" *opp-factor*)
                        (swap-ok? "opp-policy" *opp0*))
                    (show "RSI2_RULE_AT_ARENA_KNOBS"
                          (if (step-legit?) (try (play) (catch (e) e)) "gate-fail"))
                    (show "RSI2_ROUNDS" *rounds-done*)
                    (show "RSI2_HEAL" *heals*)
                    (show "RSI2_HEAL_FAIL" *heal-fail*)
                    (show "RSI2_GATE_REJECTS" *gate-rejects*)
                    (show "RSI2_SWAP_OK"
                          (string-append (number->string *swap-ok*)
                                         "/" (number->string *swaps*)))
                    (show "RSI2_FIBER" *fiber*)
                    (show "RSI2_FIBER_NOTE" *fiber-note*)
                    (show "RSI2_FINAL_TURNS" *rule-turns*)
                    (show "RSI2_FINAL_RULE" *rule-body*)
                    (show "RSI2_FINAL_KNOBS"
                          (list *knob-chip* *knob-hp* *knob-bonus* *knob-late*))
                    (show "RSI2_KEPT_OPP" *opp-body*)
                    (install-factored)
                    (apply-kept!)
                    (show "RSI2_FINAL_VS_KEPT"
                          (if (step-legit?) (try (play) (catch (e) e)) "gate-fail"))
                    (display "RSI2_DONE\n"))))))))
