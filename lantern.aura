; lantern - a tiny duel whose only evolving part is (rule hp ehp turn).
; Actions: 0 wait, 1 strike, 2 dodge.
; Opponent strikes on every odd turn; from turn 5 onward also strikes on even turns.
; Opp damage: 2 on turns 1-5; 3 from turn >=6 when striking. Dodge negates.
; Strike deals 2, wait heals 1 (cap 8).
; Score = damage dealt + turns lived. Max 40 turns (arena N).
; HP/EHP clamped 0-8; start hp=6 ehp=8.
; Kept generation: 27 (measured Soft score 48 @ aura 6a13b3d).
; Rule: strike 2,4,5,40 else dodge — third strike before dmg3 so late kill Soft-survives.
(export play rule)

(define (rule hp ehp turn)
  (cond ((or (= turn 2) (= turn 4) (= turn 5) (= turn 40)) 1)
        (#t 2)))

(define (opp-strike? turn)
  (or (= (modulo turn 2) 1)
      (>= turn 5)))

(define (opp-damage turn)
  (if (>= turn 6) 3 2))

(define (clamp n lo hi)
  (cond ((< n lo) lo)
        ((> n hi) hi)
        (#t n)))

(define (step hp ehp turn action)
  (let* ((them (opp-strike? turn))
         (dealt (if (= action 1) 2 0))
         (taken (cond ((and them (= action 2)) 0)
                      (them (opp-damage turn))
                      (#t 0)))
         (healed (if (= action 0) 1 0))
         (hp2 (clamp (- (+ hp healed) taken) 0 8))
         (ehp2 (clamp (- ehp dealt) 0 8)))
    (cons hp2 ehp2)))

(define (play)
  (let loop ((hp 6) (ehp 8) (turn 1) (score 0))
    (cond ((or (<= hp 0) (<= ehp 0) (> turn 40)) score)
          (#t
           (let* ((action (rule hp ehp turn))
                  (dealt (if (= action 1) 2 0))
                  (nxt (step hp ehp turn action))
                  (hp2 (car nxt))
                  (ehp2 (cdr nxt))
                  (lived (if (> hp2 0) 1 0)))
             (loop hp2 ehp2 (+ turn 1) (+ score dealt lived)))))))
