; lantern - evolving part is (rule hp ehp turn).
; Actions: 0 wait, 1 strike, 2 dodge.
; B strikes: odd always, even from turn >=5.
; Opp damage 2 before turn 6, else 3. Dodge negates the base hit.
; Arena T: Q chip (dodge costs 1 hp from turn >=15) plus clean-win bonus.
; Bonus: +2 score on the turn ehp hits 0 if hp is still >=2.
; Start hp=8 (was 6 under S/R) so Soft clean-win Soft-path can Soft-reach hp>=2.
; Strike deals 2, wait heals 1 (cap 8). Max 48 turns.
; Score = damage + turns lived + clean bonus. Clamp 0-8.
; Kept generation: 34 (measured Soft score 27 @ aura 6a13b3d).
; Rule: strike 2,4,5,20 else dodge. Soft +2 fired earlier on gen33 (kill@16 hp=2 Soft26).
(export play rule)

(define (rule hp ehp turn)
  (cond ((or (= turn 2) (= turn 4) (= turn 5) (= turn 20)) 1)
        (#t 2)))

(define (opp-strike? turn)
  (or (= (modulo turn 2) 1)
      (>= turn 5)))

(define (opp-damage turn)
  (if (>= turn 6) 3 2))

(define (dodge-chip turn action them)
  (if (and (>= turn 15) them (= action 2)) 1 0))

(define (clamp n lo hi)
  (cond ((< n lo) lo)
        ((> n hi) hi)
        (#t n)))

(define (step hp ehp turn action)
  (let* ((them (opp-strike? turn))
         (dealt (if (= action 1) 2 0))
         (chip (dodge-chip turn action them))
         (base-taken (cond ((and them (= action 2)) 0)
                           (them (opp-damage turn))
                           (#t 0)))
         (taken (+ base-taken chip))
         (healed (if (= action 0) 1 0))
         (hp2 (clamp (- (+ hp healed) taken) 0 8))
         (ehp2 (clamp (- ehp dealt) 0 8)))
    (cons hp2 ehp2)))

(define (play)
  (let loop ((hp 8) (ehp 8) (turn 1) (score 0))
    (cond ((or (<= hp 0) (<= ehp 0) (> turn 48)) score)
          (#t
           (let* ((action (rule hp ehp turn))
                  (dealt (if (= action 1) 2 0))
                  (nxt (step hp ehp turn action))
                  (hp2 (car nxt))
                  (ehp2 (cdr nxt))
                  (lived (if (> hp2 0) 1 0))
                  (bonus (if (and (<= ehp2 0) (>= hp2 2)) 2 0)))
             (loop hp2 ehp2 (+ turn 1) (+ score dealt lived bonus)))))))
