; lantern duel — Arena T physics, in-session fitness via (play).
; Soft is the Aura Soft-sandbox binary. Fitness is (play) in this process,
; not an external oneshot "Soft score".
; Actions: 0 wait (heal 1, cap 8), 1 strike (deal 2), 2 dodge.
; Fixed arena: start hp=8, dodge chip 1 when dodging a strike from turn >=15,
; clean-win +2 if ehp hits 0 with hp still >=2, max 48 turns.
; Initial opponent matches Arena T "B": odd turns always strike, even turns
; from turn >=5, damage 2 before turn 6 else 3. That schedule lives in
; opp-policy so a later hot-strategy swap can replace it.
; Initial rule: strike on turns 2,4,5,20 else dodge.
(export play rule opp-policy opp-strike? opp-damage)

(define (rule hp ehp turn)
  (cond ((or (= turn 2) (= turn 4) (= turn 5) (= turn 20)) 1)
        (#t 2)))

(define (opp-policy turn)
  (if (or (= (modulo turn 2) 1) (>= turn 5))
      (if (>= turn 6) 3 2)
      0))

(define (opp-strike? turn)
  (> (opp-policy turn) 0))

(define (opp-damage turn)
  (let ((p (opp-policy turn)))
    (if (> p 0) p 2)))

(define (dodge-chip turn action them)
  (if (and (>= turn 15) them (= action 2)) 1 0))

(define (clamp n lo hi)
  (cond ((< n lo) lo)
        ((> n hi) hi)
        (#t n)))

(define (step hp ehp turn action)
  (let* ((them (opp-strike? turn))
         (dealt (if (= action 1) 2 0))
         (chip (dodge-chip turn action them))
         (base-taken (cond ((and them (= action 2)) 0)
                           (them (opp-damage turn))
                           (#t 0)))
         (taken (+ base-taken chip))
         (healed (if (= action 0) 1 0))
         (hp2 (clamp (- (+ hp healed) taken) 0 8))
         (ehp2 (clamp (- ehp dealt) 0 8)))
    (cons hp2 ehp2)))

(define (play)
  (let loop ((hp 8) (ehp 8) (turn 1) (score 0))
    (cond ((or (<= hp 0) (<= ehp 0) (> turn 48)) score)
          (#t
           (let* ((action (rule hp ehp turn))
                  (dealt (if (= action 1) 2 0))
                  (nxt (step hp ehp turn action))
                  (hp2 (car nxt))
                  (ehp2 (cdr nxt))
                  (lived (if (> hp2 0) 1 0))
                  (bonus (if (and (<= ehp2 0) (>= hp2 2)) 2 0)))
             (loop hp2 ehp2 (+ turn 1) (+ score dealt lived bonus)))))))
