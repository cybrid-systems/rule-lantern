; Restricted probe. No AURA_SANDBOX=off. No set-code.
; `rule` here is the duel player, not the std/rule DSL.
;
; argv `./aura evolve_restricted.aura` evaluates this file. That does
; not install workspace_flat_ (only set-code / load do). This script
; records that, then tries (load lantern.aura), which is the other
; Soft workspace install, then mutate:rebind. If mutate is denied,
; NATIVE_RESTRICTED_OK=0 and this branch stops.

(define (show k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(show "SANDBOX" (getenv "AURA_SANDBOX"))
(show "ARGV_CURRENT_LEN" (string-length (current-source)))
(show "ARGV_WS_LEN" (string-length (current-source :workspace)))
(show "SNAP_BEFORE" (try (ast:snapshot) (catch (e) e)))

(define *loaded*
  (try (load "/workspace/rule-lantern/lantern.aura") (catch (e) e)))
(show "LOAD" *loaded*)
(show "SNAP_AFTER_LOAD" (try (ast:snapshot) (catch (e) e)))

(define *before* (try (play) (catch (e) e)))
(show "PLAY_BEFORE" *before*)

(define *alt* "(define (rule hp ehp t) (if (= t 16) 1 0))")
(define *rebind*
  (try (mutate:rebind "rule" *alt* "restricted-strike16") (catch (e) e)))
(show "REBIND" *rebind*)

(define *denied*
  (or (not (equal? *rebind* #t))
      (and (pair? *rebind*) (equal? (car *rebind*) 'capability-denied))))

(if (not (equal? *rebind* #t))
    (begin
      (show "NATIVE_RESTRICTED_OK" 0)
      (show "RESTRICTED_STOP" "mutate-denied-or-not-true"))
    (begin
      (try (eval-current) (catch (e) (show "EVAL_CURRENT" e)))
      (let ((after (try (play) (catch (e) e)))
            (at16 (try (rule 8 8 16) (catch (e) e))))
        (show "PLAY_AFTER" after)
        (show "RULE_AT_16" at16)
        (show "NATIVE_RESTRICTED_OK"
              (if (and (number? *before*)
                       (number? after)
                       (not (= *before* after))
                       (equal? at16 1))
                  1
                  0)))))
