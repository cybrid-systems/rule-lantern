; Aura-native co-evolution of the lantern duel.
; Soft binary is the Aura process. In-session fitness is (play), not the binary.
;
; `rule` is the player function. std/rule (rule:define / rule:apply) is a
; different DSL and is not required here. The names collide; do not import it.
;
; hot-strategy is a single active name (*hs-name*). Both `rule` and
; `opp-policy` still go through hot-strategy:swap! / heal!. Before each
; swap the active name is register!'d to the name about to change, so
; heal! restores that name's last-good snapshot (the snapshot includes
; the other function). If heal! returns false, both best bodies are
; force-swapped back.
;
; std/swarm is one population. A round is: init+step on rule (maximize
; play), then init+step on opp-policy (fitness is (- 0.0 play)). The
; second init drops the first population. That is the alternate round.
;
; Fiber: swarm "parallel" #t uses fiber:spawn/join inside swarm-eval-pop.
; That path runs a pure turn-list simulator (no mutate). Concurrent
; rebind on one workspace is not the fiber path.

(require "std/swarm" all:)
(require "std/hot-strategy" all:)

(define *rule0*
  "(lambda (hp ehp turn) (cond ((or (= turn 2) (= turn 4) (= turn 5) (= turn 20)) 1) (#t 2)))")
(define *opp0*
  "(lambda (turn) (if (or (= (modulo turn 2) 1) (>= turn 5)) (if (>= turn 6) 3 2) 0))")

(define *rule-body* *rule0*)
(define *rule-turns* "(2 4 5 20)")
(define *installed-rule* "")
(define *opp-body* *opp0*)
(define *installed-opp* "")
(define *rule-best-current* -1)
(define *rule-vs-b* -1)
(define *rule-vs-b-body* *rule0*)
(define *rule-vs-b-turns* "(2 4 5 20)")
(define *opp-player* 1000000)
(define *opp-at-rule* *rule0*)
(define *heals* 0)
(define *opp-heals* 0)
(define *heal-fail* 0)
(define *swaps* 0)
(define *swap-ok* 0)
(define *rule-steps* 0)
(define *opp-steps* 0)
(define *kinds* "")
(define *kind-fail* "")
(define *fiber* 0)
(define *fiber-note* "not-run")
(define *colony* "not-run")
(define *synth* "not-run")
(define *agent* "not-run")
(define *orch* "not-run")

(define (nth xs i)
  (let loop ((ys xs) (k i))
    (if (null? ys) 0
        (if (= k 0) (car ys) (loop (cdr ys) (- k 1))))))

(define (clamp-int x lo hi)
  (let ((n (round x)))
    (cond ((< n lo) lo)
          ((> n hi) hi)
          (#t n))))

(define (fresh n a b c)
  (let loop ((k n) (guard 0))
    (cond ((> guard 60) n)
          ((or (= k a) (= k b) (= k c))
           (loop (if (>= k 40) 2 (+ k 1)) (+ guard 1)))
          (#t k))))

(define (genes->turns ind)
  (let* ((a (clamp-int (nth ind 0) 2 40))
         (b (fresh (clamp-int (nth ind 1) 2 40) a -1 -1))
         (c (fresh (clamp-int (nth ind 2) 2 40) a b -1))
         (d (fresh (clamp-int (nth ind 3) 2 40) a b c)))
    (list a b c d)))

(define (turns->body ts)
  (string-append
    "(lambda (hp ehp turn) (cond ((or (= turn " (number->string (nth ts 0))
    ") (= turn " (number->string (nth ts 1))
    ") (= turn " (number->string (nth ts 2))
    ") (= turn " (number->string (nth ts 3))
    ")) 1) (#t 2)))"))

(define (genes->body ind)
  (turns->body (genes->turns ind)))

(define (ant-rule-turns name)
  (cond ((equal? name "t-24520") (list 2 4 5 20))
        ((equal? name "t-24516") (list 2 4 5 16))
        ((equal? name "t-24518") (list 2 4 5 18))
        ((equal? name "t-24519") (list 2 4 5 19))
        ((equal? name "t-23416") (list 2 3 4 16))
        ((equal? name "t-24512") (list 2 4 5 12))
        ((equal? name "t-1234") (list 1 2 3 4))
        (#t (list 2 4 5 20))))

(define (rule-of ind)
  (if (string? ind)
      (let ((ts (ant-rule-turns ind)))
        (cons (turns->body ts) ts))
      (let ((ts (genes->turns ind)))
        (cons (turns->body ts) ts))))

(define (opp-genes->body ind)
  (let* ((start (clamp-int (nth ind 0) 1 30))
         (brk (clamp-int (nth ind 1) 1 40))
         (early (if (< (nth ind 2) 21.0) 2 3))
         (late (if (< (nth ind 3) 21.0) 2 3)))
    (string-append
      "(lambda (turn) (if (>= turn " (number->string start)
      ") (if (>= turn " (number->string brk)
      ") " (number->string late)
      " " (number->string early)
      ") (if (= (modulo turn 2) 1) " (number->string early)
      " 0)))")))

(define (ant-opp-body name)
  (cond ((equal? name "o-b") *opp0*)
        ((equal? name "o-all3") (opp-genes->body (list 1 1 30 30)))
        ((equal? name "o-all2") (opp-genes->body (list 1 1 0 0)))
        ((equal? name "o-from5") (opp-genes->body (list 5 6 0 30)))
        ((equal? name "o-from1-d2") (opp-genes->body (list 1 48 0 0)))
        ((equal? name "o-late") (opp-genes->body (list 2 34 0 0)))
        (#t *opp0*)))

(define (opp-of ind)
  (if (string? ind) (ant-opp-body ind) (opp-genes->body ind)))

(define (swap-ok? name body)
  (set! *swaps* (+ *swaps* 1))
  (let ((r (try (hot-strategy:swap! name body "lantern-native")
                (catch (e) (list #f e)))))
    (if (and (pair? r) (equal? (car r) #t))
        (begin
          (set! *swap-ok* (+ *swap-ok* 1))
          (if (equal? name "rule")
              (set! *installed-rule* body)
              (set! *installed-opp* body))
          #t)
        #f)))

(define (note-kind s)
  (set! *kinds* (string-append *kinds* s " ")))

(define (note-fail s)
  (set! *kind-fail* (string-append *kind-fail* s " ")))

(define (vs-b?)
  (equal? *opp-body* *opp0*))

(define (heal-active!)
  (let ((h (try (hot-strategy:heal!) (catch (e) #f))))
    (if h
        #t
        (begin
          (set! *heal-fail* (+ *heal-fail* 1))
          #f))))

(define (force-pair)
  (swap-ok? "rule" *rule-body*)
  (hot-strategy:register! "rule" *rule-body*)
  (swap-ok? "opp-policy" *opp-body*)
  (hot-strategy:register! "opp-policy" *opp-body*))

; Single-name hot-strategy: register the name we are about to swap so
; heal! snapshots the current best pair under that name.
(define (arm! name body)
  (hot-strategy:register! name body))

(define (rule-fit ind)
  (let* ((rb (rule-of ind))
         (body (car rb))
         (ts (cdr rb)))
    (if (not (swap-ok? "rule" body))
        -1000000.0
        (let ((score (try (play) (catch (e) -1))))
          (cond ((not (number? score))
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 -1000000.0)
                ((> score *rule-best-current*)
                 (set! *rule-best-current* score)
                 (set! *rule-body* body)
                 (set! *rule-turns* ts)
                 (set! *installed-rule* body)
                 (if (vs-b?)
                     (begin
                       (set! *rule-vs-b* score)
                       (set! *rule-vs-b-body* body)
                       (set! *rule-vs-b-turns* ts))
                     #f)
                 (arm! "rule" body)
                 score)
                ((< score *rule-best-current*)
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 score)
                (#t score))))))

(define (opp-fit ind)
  (let ((body (opp-of ind)))
    (if (not (swap-ok? "opp-policy" body))
        -1000000.0
        (let ((score (try (play) (catch (e) 1000000))))
          (cond ((not (number? score))
                 (set! *opp-heals* (+ *opp-heals* 1))
                 (heal-active!)
                 -1000000.0)
                ((< score *opp-player*)
                 (set! *opp-player* score)
                 (set! *opp-body* body)
                 (set! *opp-at-rule* *rule-body*)
                 (set! *installed-opp* body)
                 (arm! "opp-policy" body)
                 (- 0.0 score))
                ((> score *opp-player*)
                 (set! *opp-heals* (+ *opp-heals* 1))
                 (heal-active!)
                 (- 0.0 score))
                (#t (- 0.0 score)))))))

(define (install-duel)
  (let ((src (try (read-file "/workspace/rule-lantern/lantern.aura")
                  (catch (e) e))))
    (if (not (string? src))
        (begin (display "SET_CODE=read-failed\n") #f)
        (let ((sc (try (set-code src) (catch (e) e))))
          (display "SET_CODE=")
          (display (if (equal? sc #t) "ok" sc))
          (newline)
          (if (equal? sc #t)
              (begin (eval-current) #t)
              #f)))))

(define (bounds4 lo hi)
  (list (list lo hi) (list lo hi) (list lo hi) (list lo hi)))

(define (init-num kind seed pop lo hi)
  (swarm:parallel! #f)
  (swarm:init (hash "kind" kind
                    "dim" 4
                    "pop" pop
                    "seed" seed
                    "bounds" (bounds4 lo hi))))

(define (init-ant seed ops)
  (swarm:parallel! #f)
  (swarm:init (hash "kind" "ant"
                    "pop" 4
                    "seed" seed
                    "evaporate" 0.9
                    "ops" ops)))

(define (rule-step kind)
  (arm! "rule" *rule-body*)
  (let ((k (try (begin (swarm:step! rule-fit) (swarm:kind))
                (catch (e) (list "fail" e)))))
    (set! *rule-steps* (+ *rule-steps* 1))
    (if (equal? k kind)
        (note-kind (string-append "rule:" kind))
        (note-fail (string-append "rule:" kind "=" (if (string? k) k "err"))))
    (swap-ok? "rule" *rule-body*)
    (arm! "rule" *rule-body*)))

(define (opp-step kind)
  (arm! "opp-policy" *opp-body*)
  (let ((k (try (begin (swarm:step! opp-fit) (swarm:kind))
                (catch (e) (list "fail" e)))))
    (set! *opp-steps* (+ *opp-steps* 1))
    (if (equal? k kind)
        (note-kind (string-append "opp:" kind))
        (note-fail (string-append "opp:" kind "=" (if (string? k) k "err"))))
    (swap-ok? "opp-policy" *opp-body*)
    (arm! "opp-policy" *opp-body*)))

(define (round-num kind seed pop rlo rhi olo ohi)
  (init-num kind seed pop rlo rhi)
  (rule-step kind)
  ; Opponent search sees the rule this round just kept.
  (set! *rule-best-current* (try (play) (catch (e) *rule-best-current*)))
  (init-num kind (+ seed 1) pop olo ohi)
  (opp-step kind)
  ; Next rule round is scored against the opp this round just kept.
  (set! *rule-best-current* (try (play) (catch (e) *rule-best-current*))))

(define (round-ant seed)
  (init-ant seed
            (list "t-24520" "t-24516" "t-24518" "t-24519"
                  "t-23416" "t-24512" "t-1234"))
  (rule-step "ant")
  (set! *rule-best-current* (try (play) (catch (e) *rule-best-current*)))
  (init-ant (+ seed 1)
            (list "o-b" "o-all3" "o-all2" "o-from5" "o-from1-d2" "o-late"))
  (opp-step "ant")
  (set! *rule-best-current* (try (play) (catch (e) *rule-best-current*))))

; Pure Arena T simulator for fiber pop eval. Strike turns else dodge.
; Reads live opp-policy. Does not rebind.
(define (clamp n lo hi)
  (cond ((< n lo) lo)
        ((> n hi) hi)
        (#t n)))

(define (sim-play ts)
  (let loop ((hp 8) (ehp 8) (turn 1) (score 0))
    (cond ((or (<= hp 0) (<= ehp 0) (> turn 48)) score)
          (#t
           (let* ((action (if (or (= turn (nth ts 0))
                                  (= turn (nth ts 1))
                                  (= turn (nth ts 2))
                                  (= turn (nth ts 3)))
                              1 2))
                  (dealt (if (= action 1) 2 0))
                  (pol (opp-policy turn))
                  (them (> pol 0))
                  (chip (if (and (>= turn 15) them (= action 2)) 1 0))
                  (dmg (if (> pol 0) pol 2))
                  (base-taken (cond ((and them (= action 2)) 0)
                                    (them dmg)
                                    (#t 0)))
                  (taken (+ base-taken chip))
                  (hp2 (clamp (- hp taken) 0 8))
                  (ehp2 (clamp (- ehp dealt) 0 8))
                  (lived (if (> hp2 0) 1 0))
                  (bonus (if (and (<= ehp2 0) (>= hp2 2)) 2 0)))
             (loop hp2 ehp2 (+ turn 1) (+ score dealt lived bonus)))))))

(define (fiber-pop!)
  (let ((spawned (try (fiber:join (fiber:spawn (lambda () 41)))
                      (catch (e) (list "fail" e)))))
    (display "FIBER_SPAWN=")
    (display spawned)
    (newline)
    (if (not (equal? spawned 41))
        (begin
          (set! *fiber* 0)
          (set! *fiber-note* "spawn-join-failed"))
        (let ((base-sim (try (sim-play (list 2 4 5 20)) (catch (e) e)))
              (base-play (try (play) (catch (e) e))))
          (display "FIBER_SIM_BASE=")
          (display base-sim)
          (newline)
          (display "FIBER_PLAY_BASE=")
          (display base-play)
          (newline)
          (if (not (equal? base-sim base-play))
              (begin
                (set! *fiber* 0)
                (set! *fiber-note* "sim-mismatch-skip-pop"))
              (let ((pop (try
                           (begin
                             (swarm:init (hash "kind" "pso"
                                               "dim" 4
                                               "pop" 4
                                               "seed" 9001
                                               "parallel" #t
                                               "bounds" (bounds4 2.0 40.0)))
                             (swarm:step! (lambda (ind) (sim-play (genes->turns ind))))
                             (swarm:best))
                           (catch (e) (list "fail" e)))))
                (display "FIBER_POP_BEST=")
                (display pop)
                (newline)
                (if (not (pair? pop))
                    (begin
                      (set! *fiber* 0)
                      (set! *fiber-note* "parallel-step-failed"))
                    (begin
                      (set! *fiber* 1)
                      (set! *fiber-note* "swarm-parallel-pso")
                      (swarm:parallel! #f)
                      (let* ((ts (genes->turns pop))
                             (body (turns->body ts))
                             (simv (sim-play ts)))
                        (arm! "rule" *rule-body*)
                        (if (swap-ok? "rule" body)
                            (let ((sc (try (play) (catch (e) -1))))
                              (display "FIBER_CONFIRM_PLAY=")
                              (display sc)
                              (newline)
                              (display "FIBER_CONFIRM_SIM=")
                              (display simv)
                              (newline)
                              (if (and (number? sc) (> sc *rule-vs-b*) (vs-b?))
                                  (begin
                                    (set! *rule-vs-b* sc)
                                    (set! *rule-vs-b-body* body)
                                    (set! *rule-vs-b-turns* ts)
                                    (set! *rule-body* body)
                                    (set! *rule-turns* ts)
                                    (set! *rule-best-current* sc)
                                    (arm! "rule" body))
                                  (begin
                                    (set! *heals* (+ *heals* 1))
                                    (heal-active!)
                                    (swap-ok? "rule" *rule-body*)
                                    (arm! "rule" *rule-body*))))
                            (display "FIBER_CONFIRM_SWAP_FAIL\n")))))))))))

(define (show tag v)
  (display tag)
  (display "=")
  (display v)
  (newline))

(define *opp-kept* *opp0*)

(define (remeasure-b)
  (set! *opp-kept* *opp-body*)
  (set! *rule-body* *rule-vs-b-body*)
  (set! *rule-turns* *rule-vs-b-turns*)
  (set! *opp-body* *opp0*)
  (force-pair)
  (try (play) (catch (e) e)))

(define (probe-tail)
  (require "std/orchestrator" all:)
  (set! *orch*
    (try
      (begin
        (orch:define-role "echo" (hash "handler" (lambda (x) x)))
        (orch:step "echo" 7))
      (catch (e) (list "fail" e))))
  (show "NATIVE_ORCH" *orch*)

  ; std/agent is required before the swarm. Requiring it after a long
  ; mutate session aborted the process (unbound api-url inside agent.aura).
  (require "std/ant" all:)
  (set! *colony*
    (try (colony:search "27" 1) (catch (e) (list "fail" e))))
  (show "NATIVE_COLONY" *colony*)

  ; colony:search set-codes and rebinds. Put the duel file back, then
  ; the kept pair. Do this before synthesize so optimize sees the duel,
  ; and again after so the process does not keep a colony body.
  (install-duel)
  (force-pair)

  (set! *synth*
    (try
      (synthesize:optimize "rule"
                           :population 2
                           :generations 1
                           :mutation-rate 0.2
                           :fitness "(play)")
      (catch (e) (list "fail" e))))
  (show "NATIVE_SYNTH" *synth*)
  (install-duel)
  (force-pair))

(display "NATIVE_START\n")
(if (install-duel)
    (let ((s0 (try (play) (catch (e) -1))))
      (show "BASE_PLAY" s0)
      (set! *rule-best-current* (if (number? s0) s0 -1))
      (set! *rule-vs-b* (if (number? s0) s0 -1))
      (set! *opp-player* (if (number? s0) s0 1000000))
      (set! *installed-rule* *rule0*)
      (set! *installed-opp* *opp0*)
      (arm! "rule" *rule0*)
      (arm! "opp-policy" *opp0*)
      (set! *agent*
        (try
          (begin
            (require "std/agent" all:)
            (agent:closed-loop-once :skip-set-code :summary "probe-clamp"
                                    :rebind "clamp"
                                    "(lambda (n lo hi) (cond ((< n lo) lo) ((> n hi) hi) (#t n)))"))
          (catch (e) (list "fail" e))))
      (show "NATIVE_AGENT" *agent*)
      (let ((ap (try (play) (catch (e) e))))
        (if (not (equal? ap s0))
            (begin
              (install-duel)
              (arm! "rule" *rule0*)
              (arm! "opp-policy" *opp0*)
              (show "AGENT_PLAY_RESET" ap))
            (show "AGENT_PLAY" ap)))
      (fiber-pop!)
      (swarm:parallel! #f)
      ; Alternate rounds: each round is one swarm step on rule (maximize
      ; play) then one on opp-policy (minimize player play). std/swarm
      ; holds a single population, so each side re-inits.
      (round-num "pso" 424242 4 2.0 40.0 1.0 40.0)
      (round-num "pso" 424244 4 2.0 40.0 1.0 40.0)
      (round-ant 424250)
      (round-num "grid" 424260 4 2.0 40.0 1.0 40.0)
      (round-num "abc" 424270 4 2.0 40.0 1.0 40.0)
      (show "NATIVE_OPP_INSEARCH" *opp-player*)
      (let ((vs-b (remeasure-b)))
        (show "NATIVE_RULE_BEST" vs-b)
        (show "NATIVE_RULE_TURNS" *rule-vs-b-turns*)
        (show "NATIVE_RULE" *rule-vs-b-body*)
        ; Remeasure kept-vs-B rule against the opp body saved before the
        ; B remeasure, then the rule that was installed when that opp won.
        (set! *opp-body* *opp-kept*)
        (set! *rule-body* *rule-vs-b-body*)
        (force-pair)
        (show "NATIVE_VS_OPP" (try (play) (catch (e) e)))
        (set! *opp-body* *opp-kept*)
        (set! *rule-body* *opp-at-rule*)
        (force-pair)
        (show "NATIVE_OPP_BEST" (try (play) (catch (e) e)))
        (show "NATIVE_OPP" *opp-body*)
        (show "NATIVE_OPP_AT_RULE" *opp-at-rule*))
      (show "NATIVE_HEAL" *heals*)
      (show "NATIVE_OPP_HEAL" *opp-heals*)
      (show "NATIVE_HEAL_FAIL" *heal-fail*)
      (show "NATIVE_SWAP_OK" (string-append (number->string *swap-ok*) "/" (number->string *swaps*)))
      (show "NATIVE_RULE_STEPS" *rule-steps*)
      (show "NATIVE_OPP_STEPS" *opp-steps*)
      (show "NATIVE_KINDS" *kinds*)
      (show "NATIVE_KIND_FAIL" *kind-fail*)
      (show "NATIVE_FIBER" *fiber*)
      (show "NATIVE_FIBER_NOTE" *fiber-note*)
      (probe-tail)
      (show "NATIVE_PLAY_RESTORED" (try (play) (catch (e) e))))
    (display "NATIVE_INSTALL_FAILED\n"))
(display "NATIVE_DONE\n")
