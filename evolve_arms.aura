
; Arms race. Same Soft process, AURA_SANDBOX=off, set-code of lantern.aura.
; Alternate: swarm rule (max play) then swarm opp-policy (min play).
; Stop at plateau (neither side moved the score) or N=4.
; `rule` is the duel player, not std/rule.

(require "std/swarm" all:)
(require "std/hot-strategy" all:)

(define *rule0*
  "(lambda (hp ehp turn) (cond ((or (= turn 2) (= turn 4) (= turn 5) (= turn 20)) 1) (#t 2)))")
(define *opp0*
  "(lambda (turn) (if (or (= (modulo turn 2) 1) (>= turn 5)) (if (>= turn 6) 3 2) 0))")

(define *rule-body* *rule0*)
(define *rule-turns* "(2 4 5 20)")
(define *installed-rule* *rule0*)
(define *opp-body* *opp0*)
(define *installed-opp* *opp0*)
(define *rule-best-current* -1)
(define *rule-vs-b* -1)
(define *rule-vs-b-body* *rule0*)
(define *rule-vs-b-turns* "(2 4 5 20)")
(define *opp-player* 1000000)
(define *opp-at-rule* *rule0*)
(define *heals* 0)
(define *opp-heals* 0)
(define *heal-fail* 0)
(define *swaps* 0)
(define *swap-ok* 0)
(define *rounds-done* 0)
(define *plateau* 0)
(define *fiber* 0)

(define (nth xs i)
  (let loop ((ys xs) (k i))
    (if (null? ys) 0
        (if (= k 0) (car ys) (loop (cdr ys) (- k 1))))))

(define (clamp-int x lo hi)
  (let ((n (round x)))
    (cond ((< n lo) lo)
          ((> n hi) hi)
          (#t n))))

(define (fresh n a b c)
  (let loop ((k n) (guard 0))
    (cond ((> guard 60) n)
          ((or (= k a) (= k b) (= k c))
           (loop (if (>= k 40) 2 (+ k 1)) (+ guard 1)))
          (#t k))))

(define (genes->turns ind)
  (let* ((a (clamp-int (nth ind 0) 2 40))
         (b (fresh (clamp-int (nth ind 1) 2 40) a -1 -1))
         (c (fresh (clamp-int (nth ind 2) 2 40) a b -1))
         (d (fresh (clamp-int (nth ind 3) 2 40) a b c)))
    (list a b c d)))

(define (turns->body ts)
  (string-append
    "(lambda (hp ehp turn) (cond ((or (= turn " (number->string (nth ts 0))
    ") (= turn " (number->string (nth ts 1))
    ") (= turn " (number->string (nth ts 2))
    ") (= turn " (number->string (nth ts 3))
    ")) 1) (#t 2)))"))

(define (ant-rule-turns name)
  (cond ((equal? name "t-24520") (list 2 4 5 20))
        ((equal? name "t-24516") (list 2 4 5 16))
        ((equal? name "t-24518") (list 2 4 5 18))
        ((equal? name "t-24519") (list 2 4 5 19))
        ((equal? name "t-23416") (list 2 3 4 16))
        ((equal? name "t-24512") (list 2 4 5 12))
        ((equal? name "t-1234") (list 1 2 3 4))
        (#t (list 2 4 5 20))))

(define (rule-of ind)
  (if (string? ind)
      (let ((ts (ant-rule-turns ind)))
        (cons (turns->body ts) ts))
      (let ((ts (genes->turns ind)))
        (cons (turns->body ts) ts))))

(define (opp-genes->body ind)
  (let* ((start (clamp-int (nth ind 0) 1 30))
         (brk (clamp-int (nth ind 1) 1 40))
         (early (if (< (nth ind 2) 21.0) 2 3))
         (late (if (< (nth ind 3) 21.0) 2 3)))
    (string-append
      "(lambda (turn) (if (>= turn " (number->string start)
      ") (if (>= turn " (number->string brk)
      ") " (number->string late)
      " " (number->string early)
      ") (if (= (modulo turn 2) 1) " (number->string early)
      " 0)))")))

(define (ant-opp-body name)
  (cond ((equal? name "o-b") *opp0*)
        ((equal? name "o-all3") (opp-genes->body (list 1 1 30 30)))
        ((equal? name "o-all2") (opp-genes->body (list 1 1 0 0)))
        ((equal? name "o-from5") (opp-genes->body (list 5 6 0 30)))
        ((equal? name "o-from1-d2") (opp-genes->body (list 1 48 0 0)))
        ((equal? name "o-late") (opp-genes->body (list 2 34 0 0)))
        (#t *opp0*)))

(define (opp-of ind)
  (if (string? ind) (ant-opp-body ind) (opp-genes->body ind)))

(define (swap-ok? name body)
  (set! *swaps* (+ *swaps* 1))
  (let ((r (try (hot-strategy:swap! name body "arms")
                (catch (e) (list #f e)))))
    (if (and (pair? r) (equal? (car r) #t))
        (begin
          (set! *swap-ok* (+ *swap-ok* 1))
          (if (equal? name "rule")
              (set! *installed-rule* body)
              (set! *installed-opp* body))
          #t)
        #f)))

(define (vs-b?)
  (equal? *installed-opp* *opp0*))

(define (heal-active!)
  (let ((h (try (hot-strategy:heal!) (catch (e) #f))))
    (if h
        #t
        (begin
          (set! *heal-fail* (+ *heal-fail* 1))
          #f))))

(define (arm! name body)
  (hot-strategy:register! name body))

(define (rule-fit ind)
  (let* ((rb (rule-of ind))
         (body (car rb))
         (ts (cdr rb)))
    (if (not (swap-ok? "rule" body))
        -1000000.0
        (let ((score (try (play) (catch (e) -1))))
          (cond ((not (number? score))
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 -1000000.0)
                ((> score *rule-best-current*)
                 (set! *rule-best-current* score)
                 (set! *rule-body* body)
                 (set! *rule-turns* ts)
                 (set! *installed-rule* body)
                 (if (vs-b?)
                     (begin
                       (set! *rule-vs-b* score)
                       (set! *rule-vs-b-body* body)
                       (set! *rule-vs-b-turns* ts))
                     #f)
                 (arm! "rule" body)
                 score)
                ((< score *rule-best-current*)
                 (set! *heals* (+ *heals* 1))
                 (heal-active!)
                 score)
                (#t score))))))

(define (opp-fit ind)
  (let ((body (opp-of ind)))
    (if (not (swap-ok? "opp-policy" body))
        -1000000.0
        (let ((score (try (play) (catch (e) 1000000))))
          (cond ((not (number? score))
                 (set! *opp-heals* (+ *opp-heals* 1))
                 (heal-active!)
                 -1000000.0)
                ((< score *opp-player*)
                 (set! *opp-player* score)
                 (set! *opp-body* body)
                 (set! *opp-at-rule* *rule-body*)
                 (set! *installed-opp* body)
                 (arm! "opp-policy" body)
                 (- 0.0 score))
                ((> score *opp-player*)
                 (set! *opp-heals* (+ *opp-heals* 1))
                 (heal-active!)
                 (- 0.0 score))
                (#t (- 0.0 score)))))))

(define (install-duel)
  (let ((src (try (read-file "/workspace/rule-lantern/lantern.aura")
                  (catch (e) e))))
    (if (not (string? src))
        #f
        (let ((sc (try (set-code src) (catch (e) e))))
          (display "SET_CODE=")
          (display (if (equal? sc #t) "ok" sc))
          (newline)
          (if (equal? sc #t)
              (begin (eval-current) #t)
              #f)))))

(define (bounds4 lo hi)
  (list (list lo hi) (list lo hi) (list lo hi) (list lo hi)))

(define (show k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(define (force-kept!)
  (swap-ok? "rule" *rule-body*)
  (arm! "rule" *rule-body*)
  (swap-ok? "opp-policy" *opp-body*)
  (arm! "opp-policy" *opp-body*))

(define (one-round n)
  (let ((in-r (try (play) (catch (e) -1))))
    (arm! "rule" *rule-body*)
    (set! *rule-best-current* (if (number? in-r) in-r -1))
    (swarm:parallel! #f)
    (swarm:init (hash "kind" "pso" "dim" 4 "pop" 4 "seed" (+ 300 n)
                      "bounds" (bounds4 2.0 40.0)))
    (try (swarm:step! rule-fit) (catch (e) (show "RULE_STEP_ERR" e)))
    (force-kept!)
    (let ((rs (try (play) (catch (e) -1))))
      (set! *opp-player* (if (number? rs) rs 1000000))
      (arm! "opp-policy" *opp-body*)
      (swarm:parallel! #f)
      (swarm:init (hash "kind" "ant" "pop" 4 "seed" (+ 400 n) "evaporate" 0.9
                        "ops" (list "o-b" "o-all3" "o-all2" "o-from5"
                                    "o-from1-d2" "o-late")))
      (try (swarm:step! opp-fit) (catch (e) (show "OPP_STEP_ERR" e)))
      (force-kept!)
      (let ((os (try (play) (catch (e) -1))))
        (set! *rounds-done* n)
        (set! *rule-best-current* (if (number? os) os *rule-best-current*))
        (display "ROUND ")
        (display n)
        (display " IN=")
        (display in-r)
        (display " RULE=")
        (display rs)
        (display " OPP=")
        (display os)
        (display " TURNS=")
        (display *rule-turns*)
        (newline)
        (if (and (number? rs) (number? os) (number? in-r)
                 (= rs in-r) (= os in-r))
            (set! *plateau* 1)
            #f)))))

(if (not (install-duel))
    (show "ARMS" "install-failed")
    (begin
      (let ((spawned (try (fiber:join (fiber:spawn (lambda () 41)))
                          (catch (e) e))))
        (show "FIBER_SPAWN" spawned)
        (set! *fiber* (if (equal? spawned 41) 1 0)))
      (let ((base (try (play) (catch (e) e))))
        (show "BASE_VS_B" base)
        (set! *rule-vs-b* (if (number? base) base -1))
        (set! *rule-best-current* (if (number? base) base -1)))
      (arm! "rule" *rule-body*)
      (arm! "opp-policy" *opp-body*)
      (one-round 1)
      (if (= *plateau* 0) (one-round 2) #f)
      (if (= *plateau* 0) (one-round 3) #f)
      (if (= *plateau* 0) (one-round 4) #f)
      (show "ROUNDS" *rounds-done*)
      (show "PLATEAU" *plateau*)
      (show "HEALS" *heals*)
      (show "OPP_HEALS" *opp-heals*)
      (show "HEAL_FAIL" *heal-fail*)
      (show "SWAPS" *swaps*)
      (show "SWAP_OK" *swap-ok*)
      (show "NATIVE_FIBER" *fiber*)
      (let ((final-rule *rule-body*)
            (final-turns *rule-turns*)
            (final-opp *opp-body*)
            (b-body *rule-vs-b-body*)
            (b-turns *rule-vs-b-turns*))
        (install-duel)
        (swap-ok? "rule" b-body)
        (swap-ok? "opp-policy" *opp0*)
        (show "PLAY_BEST_RULE_VS_B" (try (play) (catch (e) e)))
        (show "BEST_RULE_TURNS" b-turns)
        (swap-ok? "rule" final-rule)
        (show "PLAY_FINAL_RULE_VS_B" (try (play) (catch (e) e)))
        (show "FINAL_RULE_TURNS" final-turns)
        (swap-ok? "opp-policy" final-opp)
        (show "PLAY_FINAL_VS_KEPT_OPP" (try (play) (catch (e) e)))
        (show "KEPT_OPP" final-opp)
        (show "NATIVE_OPP_BEST" (try (play) (catch (e) e)))
        (swap-ok? "opp-policy" *opp0*)
        (show "NATIVE_RULE_VS_B" (try (play) (catch (e) e)))
        (show "NATIVE_RULE_BEST" "see PLAY_BEST_RULE_VS_B")))
)
